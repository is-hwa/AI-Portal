# 전부 비워도 동작합니다.

# HuggingFace 읽기 토큰 (선택) — 없으면 익명(5분에 500건)으로 수집하고 한도에 걸리면 기다렸다 이어갑니다.
# https://huggingface.co/settings/tokens 에서 "Read" 권한으로 발급
HF_TOKEN=

# Google Programmable Search Engine (Custom Search JSON API) — 하루 100건 무료 (선택)
# 넣으면 뉴스 탭에 국내 기사가 함께 표시됩니다.
# 1) https://console.cloud.google.com 에서 Custom Search API 사용 설정 + API 키 발급
# 2) https://programmablesearchengine.google.com 에서 검색엔진 생성 → cx 값 확인
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Postgres 주소 (선택) — 없으면 server/data/ 파일에 저장. CF에선 서비스 바인딩을 자동으로 찾는다.
DATABASE_URL=

# 사내 프록시 (선택)
HTTPS_PROXY=
NO_PROXY=

PORT=3001
