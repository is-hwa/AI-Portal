# 사내 VMware Private AI Foundation 등 OpenAI 호환 엔드포인트
# VPN 연결 시 키 없이 열려있다고 하면 PRIVATE_AI_API_KEY는 비워둬도 됩니다.
PRIVATE_AI_BASE_URL=
PRIVATE_AI_MODEL=gpt-oss-120b
PRIVATE_AI_API_KEY=

# Google Programmable Search Engine (Custom Search JSON API) — 하루 100건 무료
# 1) https://console.cloud.google.com 에서 Custom Search API 사용 설정 + API 키 발급
# 2) https://programmablesearchengine.google.com 에서 검색엔진 생성 → cx 값 확인
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Artificial Analysis Data API — 무료 티어 하루 100건 (없으면 헤드리스 브라우저로 자동 폴백)
# https://artificialanalysis.ai/data-api/docs 에서 로그인 후 API 키 발급
AA_API_KEY=

PORT=3001
